{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "game-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "game-build",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx vite build && mkdir -p node_modules/.cache/pages && ln -sfn \"$PWD/dist\" node_modules/.cache/pages/ElectroNation && python3 -m http.server 4173 --directory node_modules/.cache/pages"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8123", "--directory", "prototyp"],
      "port": 8123
    },
    {
      "name": "prototype-alt",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8124", "--directory", "prototyp"],
      "port": 8124
    }
  ]
}
